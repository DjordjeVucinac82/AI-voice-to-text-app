# Copy this file to .env and set secure values
APP_ENV=production
API_PORT=8080
MODEL_DEFAULT=small
MAX_UPLOAD_MB=25
API_KEY=replace-with-strong-key
STORAGE_DIR=/data
FRONTEND_PORT=3000

# Public DNS for production TLS (Let's Encrypt via Caddy)
DOMAIN=app.example.com
LETSENCRYPT_EMAIL=you@example.com

# Redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=86400
